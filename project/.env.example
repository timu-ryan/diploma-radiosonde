# Скопируйте в .env. Без AVIAMET_TOKEN прогоны берутся только из DATA_DIR на диске.

# Сайт открыт не в корне домена (https://aviametserver.ru/zond/) — его путь.
# Попадает в сборку фронтенда: после смены — npm run build.
# BASE_PATH=/zond/

AVIAMET_URL=https://aviametserver.ru
AVIAMET_TOKEN=
# AVIAMET_SYNC_MINUTES=10
# AVIAMET_KEEP_RUNS=2
# DATA_DIR=data

# База пользователей сайта (обязательна), см. README → «Пользователи и вход».
DB_URL=mysql://rs_site:пароль@127.0.0.1:3306/rs_site
# Ключ подписи cookie сессии: openssl rand -hex 32
SESSION_SECRET=
# SESSION_DAYS=30
# COOKIE_SECURE=1
